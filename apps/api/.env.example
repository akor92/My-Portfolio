# ---- Server ----
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Database ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://devfolio:devfolio@localhost:5432/devfolio?schema=public

# ---- Auth ----
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ---- Seed (initial admin account) ----
ADMIN_EMAIL=akorinnocent2@gmail.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Akor Innocent Oboche
