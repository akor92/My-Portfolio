// DevFolio — Prisma schema
// Data model for the portfolio platform: admin users, projects, blog posts,
// and inbound contact messages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

/// Admin/editor accounts that can manage content via the dashboard.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  posts    Post[]

  @@map("users")
}

/// Portfolio projects rendered on the public site.
model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String
  description     String   @default("")
  techStack       String[] @default([])
  repoUrl         String?
  liveUrl         String?
  imageUrl        String?
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, featured])
  @@index([sortOrder])
  @@map("projects")
}

/// Blog posts / writing published on the site.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@map("posts")
}

/// Inbound messages submitted through the public contact form.
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("messages")
}
